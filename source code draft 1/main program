import ascii
import menu
import time
MENU = menu.MENU
BAHAN = {
    "air": 2000,
    "susu": 1500,
    "kopi": 500,
    "cokelat": 400,
    "gula": 300,
    "cup": 20
}
BAHAN_PESANAN = {
    "air": 0,
    "susu": 0,
    "kopi": 0,
    "cokelat": 0,
    "gula": 0,
    "cup": 0
}
BATAS_MINIMAL = {
    "air": 250,
    "susu": 150,
    "kopi": 20,
    "cokelat": 30,
    "gula": 25,
    "cup": 5
}
SATUAN = {
    "air": "ml",
    "susu": "ml",
    "kopi": "g",
    "cokelat": "g",
    "gula": "g",
    "cup": "cup"
}
harga_pesanan = 0

def cek_stok():
    cek = True
    while cek:
        stok_kurang = False
        for barang, jumlah in BAHAN.items():
            min_stok = BATAS_MINIMAL.get(barang, 0)
            if jumlah < min_stok:
                stok_kurang = True
                break
        if stok_kurang == False:
            return
        print("\n" * 5)
        print(ascii.halaman_maintenance)
        admin_only = input()
        if admin_only == "admin":
            report()

def pilih_es():
    print("\n" * 5)
    print(ascii.halaman_es)
    pilih_es = True
    while pilih_es:
        jumlah_es = input("Pilih 'none', 'less', 'medium', atau 'normal': ").lower()
        if jumlah_es == "none":
            return 0
        elif jumlah_es == "less":
            return 25
        elif jumlah_es == "medium":
            return 35
        elif jumlah_es == "normal":
            return 50
        else:
            print("Invalid input, silahkan coba lagi")

