def pilih_extra_shot():
    print("\n" * 5)
    print(ascii.halaman_extra_shot)
    pilih_extra_shot = True
    while pilih_extra_shot:
        apakah_extra = input("Apakah Anda ingin extra shot untuk kopi anda (+Rp.4500)?\nKetik 'yes' atau 'no': ").lower()
        if apakah_extra == "yes":
            return True
        elif apakah_extra == "no":
            return False
        else:
            print("Invalid input, silahkan coba lagi.")

def report():
    print(ascii.report_atas)
    for barang, jumlah in BAHAN.items():
        min_stok = BATAS_MINIMAL.get(barang, 0)
        satuan = SATUAN.get(barang, "")
        if jumlah >= min_stok:
            status = "[ OK ]"
        else:
            status = "[LOW!]"
        stok_sekarang = f"{jumlah} {satuan}"
        stok_minimal = f"{min_stok} {satuan}"
        print(f"|         |  {barang.capitalize():<12} | {stok_sekarang:>15} | {stok_minimal:>15} |  {status} |         |")
    print(ascii.report_bawah)

    mode_report = True
    while mode_report:
        report_input = input("Ketik 'refill' untuk isi bahan, atau 'return' untuk kembali: ").lower()
        if report_input == "return":
            return
        elif report_input == "refill":
            mode_refill = True
            while mode_refill:
                pilih_bahan = input("Bahan apa yang ingin anda refill?\nKetik 'air', 'susu', 'kopi', 'gula', 'cokelat', atau 'cup': ").lower()
                if pilih_bahan == "air":
                    tambah = input(f"Masukkan jumlah air yang ingin ditambah (ml): ")
                    if tambah.isdigit() and int(tambah) > 0:
                        BAHAN[pilih_bahan] += int(tambah)
                        input(f"Berhasil menambahkan {tambah}ml air! Tekan Enter...")
                        return
                    else:
                        print("Jumlah harus berupa angka positif!")
                elif pilih_bahan == "susu":
                    tambah = input(f"Masukkan jumlah susu yang ingin ditambah (ml): ")
                    if tambah.isdigit() and int(tambah) > 0:
                        BAHAN[pilih_bahan] += int(tambah)
                        input(f"Berhasil menambahkan {tambah}ml susu! Tekan Enter...")
                        return
                    else:
                        print("Jumlah harus berupa angka positif!")
                elif pilih_bahan == "kopi":
                    tambah = input(f"Masukkan jumlah kopi yang ingin ditambah (g): ")
                    if tambah.isdigit() and int(tambah) > 0:
                        BAHAN[pilih_bahan] += int(tambah)
                        input(f"Berhasil menambahkan {tambah}g kopi! Tekan Enter...")
                        return
                    else:
                        print("Jumlah harus berupa angka positif!")
                elif pilih_bahan == "gula":
                    tambah = input(f"Masukkan jumlah gula yang ingin ditambah (g): ")
                    if tambah.isdigit() and int(tambah) > 0:
                        BAHAN[pilih_bahan] += int(tambah)
                        input(f"Berhasil menambahkan {tambah}g gula! Tekan Enter...")
                        return
                    else:
                        print("Jumlah harus berupa angka positif!")
                elif pilih_bahan == "cokelat":
                    tambah = input(f"Masukkan jumlah cokelat yang ingin ditambah (g): ")
                    if tambah.isdigit() and int(tambah) > 0:
                        BAHAN[pilih_bahan] += int(tambah)
                        input(f"Berhasil menambahkan {tambah}g cokelat! Tekan Enter...")
                        return
                    else:
                        print("Jumlah harus berupa angka positif!")
                elif pilih_bahan == "cup":
                    tambah = input(f"Masukkan jumlah cup yang ingin ditambah: ")
                    if tambah.isdigit() and int(tambah) > 0:
                        BAHAN[pilih_bahan] += int(tambah)
                        input(f"Berhasil menambahkan {tambah} buah cup! Tekan Enter...")
                        return
                    else:
                        print("Jumlah harus berupa angka positif!")
                else:
                    print("Invalid input, silahkan coba lagi.")
        else:
            print("Invalid input, silahkan coba lagi.")
def kurangi_bahan():
    for bahan, jumlah in BAHAN_PESANAN.items():
        BAHAN[bahan] -= jumlah
    for item in BAHAN_PESANAN:
        BAHAN_PESANAN[item] = 0

def timer_bikin_kopi(waktu):
    print("\n" * 5)
    print(ascii.halaman_progress)
    for i in range(waktu, 0 , -1):
        detik = i % 60
        menit = int(i / 60) % 60
        print(f"\r{menit:02}:{detik:02}", end="", flush=True)
        time.sleep(1)
    print(f"\rKopi berhasil dibuat.")

def mesin_kopi():
    cek_stok()
    print(ascii.halaman0)
    input()
    halaman = 1
    pilih_halaman = True
    while pilih_halaman:
        if halaman == 1:
            print(ascii.halaman1)
            input_text = "Pilih nomor menu yang anda atau pilih 'next': "
        elif halaman == 2:
            print(ascii.halaman2)
            input_text = "Pilih nomor menu, 'prev', atau 'admin': "
        elif halaman == "admin":
            print(ascii.admin_page)
            input_text = "Ketik command yang ingin digunakan atau 'return': "
        input_user = input(input_text).lower()
        if input_user == "next" and halaman == 1:
            halaman = 2
            print("\n" * 5)
        elif input_user == "prev" and halaman == 2:
            halaman = 1
            print("\n" * 5)
        elif input_user == "return" and halaman == "admin":
            halaman = 2
            print("\n" * 5)
        elif input_user == "admin":
            halaman = "admin"
            print("\n" * 5)
        elif input_user in MENU:
            nama_pesanan = MENU[input_user]["nama"]
            harga_pesanan = MENU[input_user]["harga"]
            BAHAN_PESANAN["air"] += MENU[input_user]["bahan"]["air"]
            BAHAN_PESANAN["susu"] += MENU[input_user]["bahan"]["susu"]
            BAHAN_PESANAN["kopi"] += MENU[input_user]["bahan"]["kopi"]
            BAHAN_PESANAN["cokelat"] += MENU[input_user]["bahan"]["cokelat"]
            BAHAN_PESANAN["cup"] += 1
            pilih_halaman = False
        elif input_user == "off":
            print("Shutting down...")
            exit()
        elif input_user == "report":
            print("\n" * 5)
            report()
            print("\n" * 5)
            halaman = "admin"
        else:
            print("Invalid input, please try again.")
            print("\n" * 5)
    if input_user in menu.opsi_es:
        BAHAN_PESANAN["air"] += pilih_es()
    if input_user in menu.opsi_gula:
        BAHAN_PESANAN["gula"] += pilih_gula()
    if input_user in menu.opsi_extra_shot:
        extra = pilih_extra_shot()
        if extra == True:
            BAHAN_PESANAN["kopi"] *= 2
            harga_pesanan += 4500
    print("\n" * 5)
    format_harga = f"{harga_pesanan:,}".replace(",", ".")
    if len(format_harga) < 37:
        format_harga = format_harga[:37].ljust(37)
    while len(format_harga) < 37:
        format_harga += " "
    halaman_payment = f'''
{ascii.qris_atas}
|                           TOTAL AMOUNT: Rp.{format_harga}|
{ascii.qris_bawah}
'''
    kurangi_bahan()
    input(halaman_payment)
    timer_bikin_kopi(5)
    print("\n" * 5)
    print(ascii.halaman_selesai)
    time.sleep(5)

mesin_nyala = True
while mesin_nyala:
    print("\n" * 5)
    mesin_kopi()
